# 复制为 .env 后填写；.env 不要提交到仓库。
# 镜像地址 = ACR 公网地址 / 命名空间 / 仓库名
ACR_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/onestarlab
# 由 deploy.sh 自动更新；也可手动指定回滚版本
IMAGE_TAG=latest
# 对外端口；若前面有 Caddy/Nginx 反向代理，配合 BIND_ADDR=127.0.0.1
APP_PORT=8080
BIND_ADDR=0.0.0.0
# 时区
TZ=Asia/Shanghai
# API_TOKEN 留空表示不校验。注意：前端在构建时注入 token，当前镜像未注入；
# 若在这里设置了非空值，页面请求会 401。建议靠 HTTPS + 反向代理鉴权。
API_TOKEN=
# 允许跨域来源，逗号分隔；同源部署保持 * 即可
CORS_ORIGINS=*
